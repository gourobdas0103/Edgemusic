{
  "name": "edgemusic",
  "version": "1.0.0",
  "description": "Serverless Cloud Audio & Podcast Streamer on Cloudflare Workers, D1 & R2",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute edgemusic-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute edgemusic-db --remote --file=./schema.sql"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "r2",
    "audio-streamer",
    "serverless"
  ],
  "author": "Gourob Das",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.162.0"
  }
}
